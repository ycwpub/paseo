{
  "name": "@getpaseo/cli",
  "version": "0.3.1",
  "description": "Paseo CLI - control your AI coding agents from the command line",
  "bin": {
    "paseo": "bin/paseo"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/stage-bundled-workspaces.mjs --clean && node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm --prefix ../.. run build:server:clean && node scripts/stage-bundled-workspaces.mjs",
    "postpack": "node scripts/stage-bundled-workspaces.mjs --clean",
    "typecheck": "tsgo --noEmit",
    "test": "npm run test:unit && npm run test:local",
    "test:unit": "vitest run src",
    "test:local": "tsx tests/run-all.ts",
    "test:e2e": "npm run test:local",
    "test:e2e:lifecycle": "npx tsx tests/e2e/agent-lifecycle.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "^0.104.2",
    "@clack/prompts": "^1.0.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@getpaseo/client": "0.2.0-beta.1",
    "@getpaseo/highlight": "0.2.0-beta.1",
    "@getpaseo/protocol": "0.2.0-beta.1",
    "@getpaseo/relay": "0.2.0-beta.1",
    "@getpaseo/server": "0.2.0-beta.1",
    "@isaacs/ttlcache": "^2.1.4",
    "@larksuiteoapi/node-sdk": "^1.71.0",
    "@lezer/common": "^1.5.0",
    "@lezer/cpp": "^1.1.5",
    "@lezer/css": "^1.3.0",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.3",
    "@lezer/javascript": "^1.5.4",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.6.2",
    "@lezer/php": "^1.0.5",
    "@lezer/python": "^1.1.18",
    "@lezer/rust": "^1.0.2",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@opencode-ai/sdk": "1.14.46",
    "@replit/codemirror-lang-csharp": "^6.2.0",
    "@xterm/headless": "^6.0.0",
    "ai": "5.0.78",
    "ajv": "^8.20.0",
    "base64-js": "^1.5.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "fast-deep-equal": "^3.1.3",
    "lezer-elixir": "^1.1.2",
    "lru-cache": "^11.5.1",
    "mime-types": "^2.1.35",
    "mnemonic-id": "^3.2.7",
    "node-pty": "1.2.0-beta.11",
    "openai": "^6.44.0",
    "p-limit": "^7.3.0",
    "p-memoize": "^8.0.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rotating-file-stream": "^3.2.9",
    "sherpa-onnx-node": "1.12.28",
    "strip-ansi": "^7.1.2",
    "tree-kill": "^1.2.2",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "which": "^5.0.0",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  },
  "bundleDependencies": [
    "@getpaseo/client",
    "@getpaseo/highlight",
    "@getpaseo/protocol",
    "@getpaseo/relay",
    "@getpaseo/server"
  ]
}
